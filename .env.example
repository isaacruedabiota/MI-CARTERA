# ---------------------------------------------------------------------------
# Cartera INICIAL: lista de tickers separados por comas (formato Yahoo Finance).
# Europa lleva sufijo de mercado: .MC Madrid, .DE Xetra, .PA Paris, .MI Milan,
# .AS Amsterdam, .L Londres.
#
# OJO: esto es solo la semilla del primer arranque. Despues la cartera se
# gestiona desde la web (desplegable "Mi cartera") y vive en la base de datos;
# cambiar esta linea ya no tiene efecto.
# ---------------------------------------------------------------------------
TICKERS=AAPL,MSFT,NVDA,SAN.MC,ITX.MC,VWCE.DE

# Nombres a mostrar. Opcional: si se omite, se usa el que devuelva Yahoo.
# Formato: TICKER=Nombre separados por punto y coma.
TICKER_NAMES=SAN.MC=Banco Santander;VWCE.DE=Vanguard FTSE All-World

# Variacion (%) a partir de la cual se busca explicacion. En valor absoluto.
MOVE_THRESHOLD_PCT=2.5

# ---------------------------------------------------------------------------
# Proveedor de IA: groq | ollama | gemini | openrouter | none
# Ninguno requiere tarjeta de credito.
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq

# Groq: clave gratuita en https://console.groq.com/keys (login Google/email).
# El catalogo de modelos cambia cada pocos meses. Si un dia da error 404,
# consulta los vigentes con:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama local (sin cuenta ni clave). En la Pi: OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Google Gemini: clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter: clave gratuita en https://openrouter.ai/keys (modelos con sufijo :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Proveedor de reserva si el primario falla (opcional). Vacio = sin reserva.
LLM_FALLBACK_PROVIDER=

# ---------------------------------------------------------------------------
# Noticias
# ---------------------------------------------------------------------------
NEWS_LANG=en
NEWS_MAX_AGE_HOURS=48
NEWS_MAX_ITEMS=6

# ---------------------------------------------------------------------------
# Aplicacion
# ---------------------------------------------------------------------------
DB_PATH=data/portfolio.db
TIMEZONE=Europe/Madrid
HOST=0.0.0.0
PORT=8000

# Scheduler interno (APScheduler). Ponlo en false si usas un systemd timer.
SCHEDULER_ENABLED=true
JOB_HOUR=22
JOB_MINUTE=30

# Token opcional para proteger POST /api/refresh. Vacio = endpoint abierto en LAN.
REFRESH_TOKEN=
